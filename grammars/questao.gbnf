# Grammar GBNF (llama.cpp) que restringe a decodificação ao schema exato da
# questão treinada. Ordem das chaves: enunciado, comando, alternativas,
# justificativas, resposta (o VALOR) e gabarito (a LETRA) por último — o
# modelo "mostra o trabalho", depois se compromete com o valor e só então
# escolhe a letra.
#
# Garante por construção: JSON válido, todas as chaves presentes, 4
# alternativas e 4 justificativas (A-D), gabarito em {A,B,C,D}. NÃO garante
# consistência lógica (letra certa) — isso é papel de check_consistency()/
# fix_gabarito() no pós-processamento, que compara `resposta` com
# `alternativas[gabarito]` por igualdade exata.
#
# Como a grammar força a emissão do campo `resposta`, ela também funciona com
# um .gguf ainda não retreinado — o modelo é obrigado a preencher o campo,
# dando ao verificador o que ele precisa mesmo antes do novo treino.
#
# Uso: llama-cli ... --grammar-file grammars/questao.gbnf

root ::= "{" ws "\"enunciado\"" ws ":" ws string ws "," ws "\"comando\"" ws ":" ws string ws "," ws "\"alternativas\"" ws ":" ws alts ws "," ws "\"justificativas\"" ws ":" ws alts ws "," ws "\"resposta\"" ws ":" ws string ws "," ws "\"gabarito\"" ws ":" ws letra ws "}"

alts ::= "{" ws "\"A\"" ws ":" ws string ws "," ws "\"B\"" ws ":" ws string ws "," ws "\"C\"" ws ":" ws string ws "," ws "\"D\"" ws ":" ws string ws "}"

letra ::= "\"A\"" | "\"B\"" | "\"C\"" | "\"D\""

string ::= "\"" char* "\""

char ::= [^"\\\x7F\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= [ \t\n]*
